<?xml version="1.0" encoding="UTF-8"?>
<!--
  DELTA - Windows Service Definition (WinSW)

  Generated by setup.ps1 (lib\DeltaInstaller.Service.ps1) into
  <AppRoot>\service\DeltaApp.xml. It is regenerated on every setup.ps1 run
  and rewritten only when its content actually changes - if you hand-edit
  this file, the next run overwrites it, so keep persistent edits in a copy
  under version control instead.

  What this does:
    - Runs the deployed DELTA runtime as the "DeltaApp" Windows Service, so
      DELTA starts automatically after a Windows reboot with no interactive
      login and survives RDP disconnect/logoff.
    - Launches node.exe DIRECTLY. It deliberately does NOT go through
      start.bat, cmd.exe, dotenv-cli, or yarn:
        * start.bat ends in `pause`, which hangs a non-interactive caller
          forever (docs/02 has warned about this since the NSSM reference
          procedure);
        * the legacy cmd.exe -> dotenv -> yarn -> react-router-serve chain
          is four separate processes with no parent/child lifetime coupling
          on Windows, which is the documented root cause of the orphaned
          launcher failure mode (Test-DeltaLauncherProcessCommandLine in
          lib\DeltaInstaller.Common.ps1);
        * dotenv/yarn resolve only via the *User* PATH of whichever account
          ran the installer (Add-YarnGlobalBinToPersistentPath), which a
          service identity does not share.
      Launching node.exe directly makes the supervised child the actual
      listening process - exact PID, one hop, no PATH dependency.
    - Loads the deployed .env through Node's own env-file option (see the
      arguments element below). The compiled application bundle never reads
      .env itself (it only reads process.env.*), so something must load it;
      that option was verified to
      parse this project's real .env byte-identically to dotenv-cli,
      including quoted-value-plus-inline-comment and single-quoted values
      containing double quotes. Secrets therefore stay in .env and are
      never copied into this file.

  Restart policy: the <onfailure> entries below are translated by WinSW into
  NATIVE Windows Service Control Manager recovery actions (verified via
  `sc qfailure`). There is deliberately no second, competing recovery
  configuration - WinSW owns this, and `sc failure` is left alone. The
  escalating delays plus <resetfailure> bound crash looping: a service that
  keeps failing stops instead of restarting forever, while a run that stays
  healthy for the reset period gets its full retry budget back.
-->
<service>

  <id>__DELTA_SERVICE_ID__</id>
  <name>__DELTA_SERVICE_DISPLAY_NAME__</name>
  <description>__DELTA_SERVICE_DESCRIPTION__</description>

  <!--
    Absolute path to node.exe, resolved at generation time by
    Find-NodeExecutable (PATH, then the Node.js installer's own registry
    key, then well-known Program Files locations) - never "node", which
    would depend on the service account's PATH.
  -->
  <executable>__DELTA_NODE_EXECUTABLE__</executable>

  <!--
    The react-router-serve CLI path is resolved dynamically from the
    INSTALLED package's own metadata (its package.json "bin" field) rather
    than hard-coded: the real path moved between versions (docs/02's old
    NSSM example named dist\cli.js, which does not exist in the version
    actually deployed here). Every path is quoted so an application
    directory containing spaces works.
  -->
  <arguments>--env-file="__DELTA_ENV_PATH__" "__DELTA_SERVE_CLI__" ./build/server/index.js</arguments>

  <!--
    The application resolves uploads/, logs/, translations, markdown content
    and its client asset directory from process.cwd(), so this MUST be the
    deployed application root.
  -->
  <workingdirectory>__DELTA_APP_ROOT__</workingdirectory>

  <!--
    Startup capture only - anything the process writes before Winston
    initializes, plus the react-router-serve banner. The application's own
    structured logging continues to go through Winston into LOG_DIR
    independently of this. Rolled by size so a long-running or
    crash-looping service cannot fill the disk.
  -->
  <logpath>__DELTA_LOG_DIRECTORY__</logpath>
  <log mode="roll-by-size">
    <sizeThreshold>__DELTA_LOG_SIZE_THRESHOLD_KB__</sizeThreshold>
    <keepFiles>__DELTA_LOG_KEEP_FILES__</keepFiles>
  </log>

  <!--
    Plain Automatic - DELTA starts as soon as the Service Control Manager can
    start it. There is deliberately NO <delayedAutoStart> element: delaying
    the start past the boot storm was an earlier attempt at startup ordering,
    and it only bought time at the cost of a window after every boot in which
    DELTA is installed, healthy, and not yet answering.

    Ordering is handled by the two mechanisms that actually address it,
    below and above:
      - the <depend> element (when DATABASE_URL points at a local PostgreSQL
        service) makes the SCM start PostgreSQL first; and
      - the bounded recovery policy covers the remaining gap, since a service
        dependency guarantees PostgreSQL is Running rather than already
        accepting connections.
    Between them, a DELTA that starts a moment too early is retried rather
    than deferred on every boot forever.
  -->
  <startmode>Automatic</startmode>
__DELTA_SERVICE_DEPENDENCY__
  <!--
    Bounded, escalating crash recovery - never an unbounded restart loop.
    After the listed attempts are exhausted the service stays stopped so the
    failure is visible rather than endlessly retried.
  -->
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="restart" delay="60 sec" />
  <resetfailure>__DELTA_RESET_FAILURE__</resetfailure>

  <!--
    On stop, WinSW sends the child a console CTRL+C, which Node surfaces as
    SIGINT. The application registers SIGINT/SIGTERM handlers that close its
    Winston transports and then exit(0) - verified end to end: the handler
    ran, cleanup ran, and the process exited with code 0 rather than being
    terminated. This timeout is the ceiling before WinSW escalates.
  -->
  <stoptimeout>__DELTA_STOP_TIMEOUT__</stoptimeout>

</service>
