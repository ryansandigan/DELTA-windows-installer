<?xml version="1.0" encoding="UTF-8"?>
<!--
  DELTA - IIS Reverse Proxy Configuration (HTTP)

  This is the canonical DELTA website's web.config, generated by
  setup-iis.ps1 (docs\todo\TODO-setup-iis-enhancements.md, Phase 6). It is
  (re)generated on every run - if you hand-edit this file, re-running
  setup-iis.ps1 will overwrite it, so make hand edits to a copy under
  version control instead if you need them to persist.

  What this does:
    - Forwards every request to the DELTA application server via
      Application Request Routing (ARR) - see the DELTA Backend comment
      block below for the port this was generated with.
    - Relies on the machine-wide system.webServer/proxy setting, enabled
      once by setup-iis.ps1's own Phase 4 (Application Request Routing),
      to actually let ARR act as a reverse proxy at all - this file's own
      <rewrite> rule alone does nothing without that. That same Phase 4
      also sets preserveHostHeader=True machine-wide, so the original
      inbound Host header (not localhost:PORT) survives the proxy hop -
      required for DELTA's own session/CSRF/Remix-action-routing logic.
    - Forwards X-Forwarded-Proto, X-Forwarded-Host, and X-Forwarded-Port
      to the backend so it can tell the original scheme/host/port apart
      from this IIS instance's own localhost connection to it - the IIS
      counterpart to the identical headers setup-nginx.ps1's own
      templates\nginx\delta-http.conf/delta-https.conf already send.
      X-Forwarded-For is NOT set here - ARR supplies it automatically
      once the machine-wide proxy setting above is enabled, so setting it
      again here would be redundant.

      The three HTTP_X_FORWARDED_* names set below are only PERMITTED to
      be set at all via a matching system.webServer/rewrite/allowedServerVariables
      entry - deliberately NOT declared in this file: confirmed directly
      (real IIS testing) that allowedServerVariables is locked
      (overrideModeDefault="Deny") at the server level by default, so a
      site-level web.config attempting to add entries here fails every
      single request with HTTP 500.52 ("URL Rewrite Module Error").
      setup-iis.ps1's own Phase 4 (Application Request Routing) adds
      these three names machine-wide (MACHINE/WEBROOT/APPHOST) instead,
      the same place `enabled`/`preserveHostHeader` are already
      configured - see Confirm-DeltaArrPostInstallState in setup-iis.ps1.

  Public hostname (this website's own HTTP binding host header - not
  anything inside this file; rerun setup-iis.ps1 to change it):

      __DELTA_SERVER_NAME__

  To serve DELTA over HTTPS, run setup-iis.ps1 again once SSL Certificate
  support exists (a later development phase) - only the website's own
  bindings change for that, not this file.
-->
<configuration>
    <system.webServer>
        <rewrite>
            <rewriteMaps>
                <!--
                  {HTTPS} is a URL Rewrite built-in server variable - "on"
                  when the inbound IIS request is HTTPS, "off" otherwise
                  (never hardcoded, since this site serves both HTTP and
                  HTTPS bindings). These two maps translate that into the
                  values X-Forwarded-Proto/X-Forwarded-Port are actually
                  expected to carry.
                -->
                <rewriteMap name="DeltaForwardedProto">
                    <add key="on" value="https" />
                    <add key="off" value="http" />
                </rewriteMap>
                <rewriteMap name="DeltaForwardedPort">
                    <add key="on" value="443" />
                    <add key="off" value="80" />
                </rewriteMap>
            </rewriteMaps>
            <rules>
                <rule name="DELTA Reverse Proxy" stopProcessing="true">
                    <!--
                      DELTA Backend

                      Backend Port:

                          __DELTA_BACKEND_PORT__

                      If you later change the PORT value in the DELTA
                      .env file, rerun setup-iis.ps1 to regenerate this
                      configuration.
                    -->
                    <match url="(.*)" />
                    <serverVariables>
                        <set name="HTTP_X_FORWARDED_PROTO" value="{DeltaForwardedProto:{HTTPS}}" />
                        <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
                        <set name="HTTP_X_FORWARDED_PORT" value="{DeltaForwardedPort:{HTTPS}}" />
                    </serverVariables>
                    <action type="Rewrite" url="http://localhost:__DELTA_BACKEND_PORT__/{R:1}" />
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
