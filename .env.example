# Base URL for the application (used for links in emails, etc.)
PUBLIC_URL="https://delta.sample.com"

# Node environment: "development" or "production"
NODE_ENV="production"

# TCP port the application listens on
PORT="3000"

DATABASE_URL="postgresql://postgres_user:postgres_password@localhost:5432/database_example"

SESSION_SECRET="GhdfJDSKjdksdjasfnasdlkasjd==" # should be random string for production

# Example SMTP configuration (when EMAIL_TRANSPORT="smtp"), either smtp or file
EMAIL_FROM='"DELTA" <no-reply@undrr.org>'
EMAIL_TRANSPORT="file" # file or smtp
SMTP_HOST="smtp.sample.com"
SMTP_PORT="587"
SMTP_USER="UNDRR"
SMTP_PASS="***"
SMTP_SECURE="false"

## REQUIRED CONFIG FOR AZURE B2C SSO
# SSO_AZURE_B2C_TENANT=""
# SSO_AZURE_B2C_CLIENT_ID=""
# SSO_AZURE_B2C_CLIENT_SECRET=""
# SSO_AZURE_B2C_USERFLOW_LOGIN=''
# SSO_AZURE_B2C_USERFLOW_LOGIN_ADMIN_REDIRECT_URL=""
# SSO_AZURE_B2C_USERFLOW_LOGIN_REDIRECT_URL=""
# SSO_AZURE_B2C_USERFLOW_EDIT=''
# SSO_AZURE_B2C_USERFLOW_EDIT_REDIRECT_URL=""
# SSO_AZURE_B2C_USERFLOW_RESET=''
# SSO_AZURE_B2C_USERFLOW_RESET_REDIRECT_URL=""

# default is form, supported values are "form", "sso_azure_b2c", or both separated by comma (e.g. "form,sso_azure_b2c")
AUTHENTICATION_SUPPORTED="form"

# Network proxy (network has HTTP proxy rule for outbound request, HTTPS doesn't work)
# HTTP_PROXY="URL"

# Support contact shown on the error page. SUPPORT_URL takes precedence over SUPPORT_EMAIL if both are set.
# Use SUPPORT_EMAIL for a mailto link, SUPPORT_URL for a contact page (plain or with query params).
SUPPORT_URL="https://www.undrr.org/contact?topic=delta"
# SUPPORT_EMAIL="support@example.com"